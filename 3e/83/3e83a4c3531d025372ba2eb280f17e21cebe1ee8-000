                os.path.join(THUMB_DIR, 'thumb-churchyard-take2-4x5-4k.jpg')], check=True)
subprocess.run(['ffmpeg', '-y', '-v', 'error', '-ss', '00:00:16.5', '-i', OUT_MOV,
                '-vframes', '1', '-vf', 'scale=1080:1350:flags=lanczos', '-q:v', '2',
                os.path.join(THUMB_DIR, 'thumb-churchyard-take2-4x5-1080.jpg')], check=True)

