import numpy as np
from PIL import Image, ImageDraw, ImageFont


def clean_chrome_bar(frame):
    """Undo the translucent Rotate bar (uniform black veil, glyphs at left).

    EN: rows 0..91 divided by BAR_ALPHA, edge row copied from below,
    glyph columns repainted with the row sky median. FR : voile inverse,
    ligne de bord recopiee, texte repeint au median du ciel.
    """
    f = frame.astype(np.float32)
    band = f[0:BAR_FULL]
    band /= BAR_ALPHA
    ref = np.median(band[:, SKY_X0:SKY_X1, :], axis=1, keepdims=True)
    band[:, 0:GLYPH_X1, :] = ref
    f[BAR_FULL] = f[BAR_FULL + 1]
    np.clip(f, 0, 255, out=f)
    return f.astype(np.uint8)

W, H = 3072, 3840
FPS = 60
TOTAL_FRAMES = 30 * FPS  # 1800 frames = 30.00 s exact

SRC_MOV = '/Users/zenray/Downloads/tmp-3D-houdini/Shorts/2026-09-15 21-07-28.mov'
OUT_DIR = '/Users/zenray/Downloads/tmp-3D-houdini/Shorts'
OUT_MOV = os.path.join(OUT_DIR, '2026-09-15-churchyard-build-take2-4x5-4k.mov')
