GLYPH_X1 = 216  # crop-rel cols 0..215 repainted (Rotate text + gizmos)
SKY_X0, SKY_X1 = 260, 560  # clean sky reference columns (crop-rel)

font_dir = os.path.expanduser('~/Library/Fonts')
sys_font_dir = '/System/Library/Fonts/Supplemental'
p_sectra_bold_italic = os.path.join(font_dir, 'GT-Sectra-LCGV-Bold-Italic.otf')
p_inter = os.path.join(font_dir, 'InterTight-Italic-VariableFont_wght.ttf')
p_serif = os.path.join(font_dir, 'AnthropicSerif-SemiBoldItalic.ttf')
p_mono = os.path.join(font_dir, 'AnthropicMono-Bold.ttf')
p_euphemia = os.path.join(sys_font_dir, 'EuphemiaCAS.ttc')
p_arialuni = os.path.join(sys_font_dir, 'Arial Unicode.ttf')

YELLOW = (0xF1, 0xF2, 0x50)

# 1. Master Title (sectra-only, auto-fit, no capsule ever)
