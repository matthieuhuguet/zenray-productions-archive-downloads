      font-family: 'FOT-Chiaro Std';
      src: local('ChiaroStd-H'), local('FOT-Chiaro Std H'), url('file:///Users/zenray/Library/Fonts/FOT-ChiaroStd-H.otf');
      font-weight: 900;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --bg: #090a0f;
      --card-bg: rgba(22, 24, 32, 0.7);
      --border: rgba(255, 255, 255, 0.1);
      --text-main: #f0f2f7;
      --text-muted: #8e95a5;
      --accent-blue: #388bfd;
      --accent-green: #2ea043;
      --accent-orange: #f0883e;
      --accent-purple: #bc8cff;
      --font-chiaro: 'FOT-Chiaro Std', serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
      --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--text-main);
      font-family: var(--font-ui);
      padding: 40px 24px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    header {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px;
      backdrop-filter: blur(12px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .badge-row {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-family: var(--font-mono);
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      color: var(--text-muted);
    }
    .badge.verified {
      background: rgba(46, 160, 67, 0.15);
      border-color: rgba(46, 160, 67, 0.4);
      color: #3fb950;
    }
    .badge.source {
      background: rgba(56, 139, 253, 0.15);
      border-color: rgba(56, 139, 253, 0.4);
      color: #58a6ff;
    }
    .badge.gold {
      background: rgba(240, 136, 62, 0.15);
      border-color: rgba(240, 136, 62, 0.4);
      color: #f0883e;
    }

    h1 {
      font-family: var(--font-chiaro);
      font-weight: 700;
      font-size: 40px;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
      color: #ffffff;
    }
    .subtitle {
      color: var(--text-muted);
      font-size: 15px;
      max-width: 900px;
    }

    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      backdrop-filter: blur(12px);
    }

    .section-title {
      font-size: 13px;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-title::before {
      content: "";
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-blue);
    }
    .sec-green::before { background: var(--accent-green); }
    .sec-orange::before { background: var(--accent-orange); }
    .sec-purple::before { background: var(--accent-purple); }

    .weight-row {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
      transition: border-color 0.2s;
    }
    .weight-row:hover {
      border-color: rgba(56, 139, 253, 0.3);
    }
    .weight-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .weight-tag {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 700;
      color: var(--accent-blue);
    }
    .weight-desc {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
    }
    .weight-sample-title {
      font-family: var(--font-chiaro);
      font-size: 28px;
      line-height: 1.3;
      margin-bottom: 6px;
      color: #fff;
    }
    .weight-sample-sub {
      font-family: var(--font-chiaro);
      font-size: 18px;
      color: rgba(255, 255, 255, 0.85);
    }

    .baseline-demo {
      position: relative;
      display: inline-block;
      padding-bottom: 2px;
      border-bottom: 2px solid #ff3b30;
      margin-bottom: 8px;
    }

    /* Live Interactive Tester */
    .tester-controls {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .weight-btn {
      padding: 8px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-main);
      font-family: var(--font-mono);
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .weight-btn.active {
      background: var(--accent-blue);
      border-color: var(--accent-blue);
      color: #fff;
    }

    .interactive-input {
      width: 100%;
      padding: 16px 20px;
      border-radius: 10px;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--border);
      color: #fff;
      font-size: 16px;
      outline: none;
      margin-bottom: 20px;
    }
    .interactive-input:focus {
      border-color: var(--accent-blue);
    }
    .live-preview {
      font-family: var(--font-chiaro);
      font-size: 38px;
      line-height: 1.4;
      padding: 24px;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 10px;
      border: 1px dashed rgba(255, 255, 255, 0.15);
      word-break: break-all;
    }

    .kanji-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .kanji-card {
      background: rgba(0, 0, 0, 0.25);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }
    .kanji-char {
      font-family: var(--font-chiaro);
      font-size: 54px;
      line-height: 1;
      margin-bottom: 6px;
      color: #fff;
    }
    .kanji-sub {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--text-muted);
    }

    footer {
      text-align: center;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-muted);
      padding: 20px 0;
    }
  </style>
</head>
<body>
