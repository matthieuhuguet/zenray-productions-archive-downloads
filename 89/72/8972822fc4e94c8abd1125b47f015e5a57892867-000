      src: local('ChiaroStd-M'), local('FOT-Chiaro Std M'), url('file:///Users/zenray/Library/Fonts/FOT-ChiaroStd-M.otf');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'FOT-Chiaro Std';
      src: local('ChiaroStd-SB'), local('FOT-Chiaro Std SB'), url('file:///Users/zenray/Library/Fonts/FOT-ChiaroStd-SB.otf');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'FOT-Chiaro Std';
      src: local('ChiaroStd-B'), local('FOT-Chiaro Std B'), url('file:///Users/zenray/Library/Fonts/FOT-ChiaroStd-B.otf');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'FOT-Chiaro Std';
      src: local('ChiaroStd-EB'), local('FOT-Chiaro Std EB'), url('file:///Users/zenray/Library/Fonts/FOT-ChiaroStd-EB.otf');
      font-weight: 800;
      font-style: normal;
