        <button class="weight-btn" data-weight="300">Light (300)</button>
        <button class="weight-btn" data-weight="400">Regular (400)</button>
        <button class="weight-btn" data-weight="500">Medium (500)</button>
        <button class="weight-btn" data-weight="600">SemiBold (600)</button>
