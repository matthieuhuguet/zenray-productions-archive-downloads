        <div class="kanji-card"><div class="kanji-char">警</div><div class="kanji-sub">U+8B66 (19 traits)</div></div>
        <div class="kanji-card"><div class="kanji-char">議</div><div class="kanji-sub">U+8B70 (20 traits)</div></div>
        <div class="kanji-card"><div class="kanji-char">薔</div><div class="kanji-sub">U+8594 (16 traits)</div></div>
        <div class="kanji-card"><div class="kanji-char">薇</div><div class="kanji-sub">U+8587 (16 traits)</div></div>
        <div class="kanji-card"><div class="kanji-char">鷹</div><div class="kanji-sub">U+9DF9 (24 traits)</div></div>
        <div class="kanji-card"><div class="kanji-char">覇</div><div class="kanji-sub">U+8987 (19 traits)</div></div>
