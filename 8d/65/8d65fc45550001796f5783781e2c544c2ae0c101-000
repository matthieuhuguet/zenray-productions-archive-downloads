t_start = time.time()
for frame_idx in range(TOTAL_FRAMES):
    raw = p_in.stdout.read(bytes_per_frame)
    if len(raw) < bytes_per_frame:
        base_frame = Image.new('RGB', (W, H), (0, 0, 0))
    else:
        base_frame = Image.frombytes('RGB', (W, H), raw)
        
    # Title paste
    base_frame.paste(title_layer, (0, 0), title_layer)
    
    # Subtitles in canon
    cue_idx = frame_idx // CUE_FRAMES
    cue_idx = min(cue_idx, len(rendered_cues) - 1)
    f_rel = frame_idx % CUE_FRAMES
    cdata = rendered_cues[cue_idx]
    
    # Line 1
    if f_rel < len(cdata['l1_frames']):
        part1 = cdata['l1_frames'][f_rel]
    else:
        part1 = cdata['l1_steady']
    if part1 is not None:
        im1, px1, py1 = part1
        base_frame.paste(im1, (px1, py1), im1)
        
    # Line 2 (canon delay)
    if f_rel >= CANON_DELAY:
        k = f_rel - CANON_DELAY
        if k < len(cdata['l2_frames']):
            part2 = cdata['l2_frames'][k]
        else:
            part2 = cdata['l2_steady']
        if part2 is not None:
            im2, px2, py2 = part2
            base_frame.paste(im2, (px2, py2), im2)
            
    p_out.stdin.write(base_frame.tobytes())
    
    if (frame_idx + 1) % 240 == 0:
        elapsed = time.time() - t_start
        fps_proc = (frame_idx + 1) / elapsed
        print(f'Frame {frame_idx+1}/{TOTAL_FRAMES} ({fps_proc:.1f} fps)...')

p_out.stdin.close()
