def render_line_card(line, font_size, cue_idx, line_idx):
    f_i = ImageFont.truetype(p_inter, font_size)
    f_i.set_variation_by_axes([700])
    
    # Scale Garamond by 1.25 for optical volume harmony with Inter and Mono
    f_g = ImageFont.truetype(p_garamond, int(round(font_size * 1.25)))
    f_m = ImageFont.truetype(p_mono, int(font_size * 0.95))
    f_euphemia = ImageFont.truetype(p_euphemia, int(font_size * 0.95))
    f_arial = ImageFont.truetype(p_arial, int(font_size * 0.90))
    pool = [f_i, f_g, f_m]
    
    rng = random.Random(cue_idx * 1337 + 42 + line_idx * 99)
    last_idx = -1
    
    words = line.split(' ')
    w_info = []
    
    for w in words:
        if 'ᕙ' in w or 'ᕗ' in w or '▿' in w:
            # Kaomoji exception: strictly Mono base + fallback glyphs to prevent missing glyph tofu
            char_items = []
            for ch in w:
                if ch in ['ᕙ', 'ᕗ']:
                    cf = f_euphemia
                    y_off = int(font_size * 0.05)
                elif ch in ['▿']:
                    cf = f_arial
                    y_off = 0
                else:
                    cf = f_m
                    y_off = 0
                cw = cf.getlength(ch)
                char_items.append((ch, cf, cw, y_off))
            w_len = sum(item[2] for item in char_items)
            w_info.append({'type': 'kaomoji', 'chars': char_items, 'width': w_len})
        else:
            choices = [i for i in range(len(pool)) if i != last_idx]
            last_idx = rng.choice(choices)
            chosen_font = pool[last_idx]
            imono = (chosen_font == f_m)
            w_len = chosen_font.getlength(w)
            w_info.append({'type': 'word', 'word': w, 'font': chosen_font, 'width': w_len, 'is_mono': imono})
        
    total_w = sum(item['width'] for item in w_info) + space_sub * (len(words) - 1)
    im_w = int(total_w + 140)
    im_h = int(font_size * 1.6 + 60)
    
    im = Image.new('RGBA', (im_w, im_h), (0, 0, 0, 0))
    d = ImageDraw.Draw(im)
    
    cur_x = 40
    base_y = int(font_size * 1.1 + 20)
    
    for item in w_info:
        if item['type'] == 'kaomoji':
            for ch, cf, cw, y_off in item['chars']:
                d.text((cur_x, base_y - y_off), ch, font=cf, fill=SUBTITLE_YELLOW, stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')
                cur_x += cw
            cur_x += space_sub
        else:
            w = item['word']
            f = item['font']
            width = item['width']
            if item['is_mono']:
                asc, desc = f.getmetrics()
                bw = int(width + 160)
                bh = int(asc + desc + 60)
                pp = Image.new('RGBA', (bw, bh), (0, 0, 0, 0))
                pd = ImageDraw.Draw(pp)
                mono_origin_x = 30
                pd.text((mono_origin_x, asc), w, font=f, fill=SUBTITLE_YELLOW, stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')
                m = (1, shear, -shear * asc, 0, 1, 0)
                sl = pp.transform((bw, bh), Image.AFFINE, m, resample=Image.BICUBIC)
                im.paste(sl, (int(cur_x - mono_origin_x), int(base_y - asc)), sl)
            else:
                d.text((cur_x, base_y), w, font=f, fill=SUBTITLE_YELLOW, stroke_width=subtitle_stroke_width, stroke_fill=(0, 0, 0), anchor='ls')
            cur_x += width + space_sub
        
    return im, im_w, im_h

# Pre-render cues for canon line-by-line
rendered_cues = []
for c_idx, cue in enumerate(cues_2lines):
    best_size = 80
    for test_size in range(120, 56, -1):
        f_test = ImageFont.truetype(p_inter, test_size)
        f_test.set_variation_by_axes([700])
        all_fit = True
        for line in cue:
            words = line.split(' ')
            total_len = sum(f_test.getlength(w) for w in words) + space_sub * (len(words) - 1)
            if total_len > MAX_W:
                all_fit = False
                break
        if all_fit:
            best_size = test_size
            break
            
    c_data = {}
    for l_idx, (line, center_pos) in enumerate(zip(cue, [c1, c2])):
        card, cw, ch = render_line_card(line, best_size, c_idx, l_idx)
        frames = []
        for s, a in punch_curve:
            if a <= 0.0:
                frames.append(None)
                continue
            nw = max(1, int(cw * s))
            nh = max(1, int(ch * s))
            scaled = card.resize((nw, nh), resample=Image.BICUBIC)
            if a < 1.0:
                alpha = scaled.split()[3]
                alpha = alpha.point(lambda p: int(p * a))
                scaled.putalpha(alpha)
            px = center_pos[0] - nw // 2
            py = center_pos[1] - nh // 2
            frames.append((scaled, px, py))
            
        steady = (card, center_pos[0] - cw // 2, center_pos[1] - ch // 2)
        c_data[f'l{l_idx+1}_frames'] = frames
        c_data[f'l{l_idx+1}_steady'] = steady
        
    rendered_cues.append(c_data)

